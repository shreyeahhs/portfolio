# Copy to .env.local for local development, and set the same names in Vercel
# (Project Settings > Environment Variables) for production.

# Chatbot (Google Gemini)
GEMINI_API_KEY=
# Optional. Both default to the -latest aliases, which track Google's current models.
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Contact form (Brevo transactional email)
BREVO_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=Shreyas
CONTACT_TO_EMAIL=

# Optional: shared rate-limit counts across all of Vercel's instances.
# Add an Upstash Redis database from the Vercel Marketplace and these are set for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
