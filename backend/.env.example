PORT=8000

# Comma-separated list. Include every origin the frontend is served from.
FRONTEND_ORIGIN=http://localhost:5173,https://your-site.vercel.app

# Gemini, from Google AI Studio. GOOGLE_API_KEY is accepted as an alias.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
# Used when the main model is overloaded.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Brevo transactional email, for the contact form.
BREVO_API_KEY=your_brevo_api_key_here
CONTACT_FROM_EMAIL=noreply@yourdomain.com
CONTACT_FROM_NAME=Shreyas
CONTACT_TO_EMAIL=where_you_want_to_receive_messages@example.com
